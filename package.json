{
  "name": "california-contractor-search",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "search:index": "tsx scripts/index-typesense.ts",
    "search:benchmark": "tsx --conditions=react-server scripts/benchmark-typesense.ts",
    "geo:import": "tsx --conditions=react-server scripts/geocode-contractors.ts",
    "data:download": "node scripts/download-cslb-data.mjs",
    "data:refresh": "tsx --conditions=react-server scripts/refresh-cslb.ts",
    "data:import": "node scripts/import-cslb-data.mjs",
    "data:finalize": "node scripts/import-cslb-data.mjs --finalize-only"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "csv-parse": "7.0.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "typesense": "3.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
