NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CIS_URL=https://www.contractorsischool.com/

# Optional Typesense 30.x search. OFF until a complete index has been validated.
TYPESENSE_ENABLED=false
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
# Stable alias, not the physical versioned collection in production.
TYPESENSE_COLLECTION=contractors
# Search-only, collection-scoped key. Used only on the Next.js server.
TYPESENSE_SEARCH_API_KEY=
# Indexing job only. Do not put this key in the Vercel web application's env.
TYPESENSE_ADMIN_API_KEY=

# Enable geographic UI/index projection only AFTER the Census migration + import
# and a validated geo-enabled Typesense v2 collection are ready. No Census key.
CENSUS_GEOCODING_ENABLED=false
# Local/long-lived worker: persistent private directory, not a Vercel filesystem.
CENSUS_STATE_DIR=.data/census

# Long-lived refresh worker ONLY, not a Vercel web-app environment variable.
# Leave off until the refresh migration and first prepared release are reviewed.
CSLB_REFRESH_ENABLED=false
# Optional Node Typesense transport workaround for local proxy environments.
TYPESENSE_FETCH_ADAPTER=false

# Local scheduled worker only. Prefer ignored .env.refresh.local; never Vercel.
# Activation also requires CSLB_REFRESH_ENABLED and CENSUS_GEOCODING_ENABLED.
CSLB_SCHEDULE_ENABLED=false
# Gmail is selected when either Gmail variable is set; no custom sender domain needed.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional explicit choice: gmail or resend. No automatic failover between providers.
CSLB_EMAIL_PROVIDER=
# Alternative Resend configuration (not required when using Gmail):
RESEND_API_KEY=
# Use a sender/domain verified in Resend; a recipient address is not a sender.
CSLB_ALERT_FROM=
CSLB_ALERT_TO=
# Independent missed-run monitor; secret UUID ping URL. Configure email there too.
CSLB_HEALTHCHECK_URL=

# Business-profile claiming. OFF until migration/Auth/CAPTCHA/admin review are verified.
# Claims and user writes NEVER use the service-role key. The optional mail worker does.
CLAIMS_ENABLED=false
CLAIMS_SITE_URL=https://californiacontractorsearch.vercel.app
# Public Turnstile site key; configure the matching secret in Supabase Auth, NOT here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLAIMS_SUPPORT_EMAIL=
# Optional post-request notifications; not the Supabase Auth email configuration.
CLAIMS_EMAIL_ENABLED=false
CLAIMS_ADMIN_EMAIL=
# The claim mail worker reuses GMAIL_USER/GMAIL_APP_PASSWORD (or explicit Resend).
# For Vercel delivery, add those only to server env; never NEXT_PUBLIC_.
# Alternatively keep delivery on this computer using npm run claims:notify -- --run.
